# Copy this file to scripts/env.conf and edit the values for your environment.
# scripts/env.conf is gitignored. The deploy script reads it automatically.
#
# Sample app: https://github.com/Azure-Samples/app-service-dotnet-agent-tutorial

# ---- Workshop identity ----
WORKSHOP_NAME=sreinprod
ENVIRONMENT_NAME=demo
AZURE_LOCATION=eastus2

# ---- Resource groups ----
# The application workload (web app, slot, AI, Log Analytics, alert) lives here.
APP_RESOURCE_GROUP=rg-sreinprod-app
# The Azure SRE Agent resource lives here (created later in Workshop module 2).
AGENT_RESOURCE_GROUP=rg-sreinprod-agent

# ---- Sample app source ----
SAMPLE_APP_REPO=https://github.com/Azure-Samples/app-service-dotnet-agent-tutorial.git
SAMPLE_APP_REF=main
SAMPLE_APP_DIR=sample-app
SAMPLE_APP_PROJECT=SreAgentMemoryDemo.csproj

# ---- Slot configuration ----
STAGING_SLOT_NAME=staging

# ---- Outputs filled in by deploy-demo-env.ps1 (do not hand-edit) ----
APP_NAME=
APP_URL=
STAGING_URL=
APP_INSIGHTS_NAME=
LOG_ANALYTICS_WORKSPACE=

